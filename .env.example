# Public site URL (used for canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://mbizanamedicalcentre.vercel.app

# Practice details (optional overrides — defaults live in lib/site.ts)
PRACTICE_EMAIL=drnogemane@gmail.com
PRACTICE_QUALIFICATIONS=MBChB (UKZN), Dip HIV Man (CMSA)
DOCTOR_BIO=
DOCTOR_PHOTO_URL=            # e.g. /images/doctor.jpg once the photo is added to public/images

# Navitas — supplied by the practice / Navitas. Leave empty until received.
NEXT_PUBLIC_NAVITAS_BOOKING_URL=   # practice booking page link
NEXT_PUBLIC_NAVITAS_EMBED_URL=     # booking widget URL (rendered in an iframe on /book-now)
NEXT_PUBLIC_NAVITAS_PORTAL_URL=    # patient portal link (button hidden while empty)

# Contact form email delivery (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Mbizana Medical Centre <noreply@your-verified-domain.co.za>
CONTACT_TO_EMAIL=drnogemane@gmail.com

# Optional Cloudflare Turnstile spam protection
TURNSTILE_SECRET_KEY=
